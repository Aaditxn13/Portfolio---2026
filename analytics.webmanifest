{
  "id": "/analytics",
  "name": "Portfolio Pulse",
  "short_name": "Pulse",
  "description": "Private analytics for Aditya Sadhukhan's portfolio.",
  "start_url": "/analytics?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f5ef",
